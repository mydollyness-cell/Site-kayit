generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id            Int      @id @default(autoincrement())
  block         String
  apartment_no  Int
  resident_type String
  name_surname  String
  phone_number  String
  created_at    DateTime @default(now())

  @@unique([block, apartment_no, phone_number])
}
